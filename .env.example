# Router9 OpenAI-compatible gateway
VOID_ROUTER_BASE_URL=http://127.0.0.1:20127/v1
VOID_ROUTER_API_KEY=

# Optional remote OpenAI-compatible gateway
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=

# Existing multimodal providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_VIDEO_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
JINA_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
HF_TOKEN=
# Alias accepted for convenience: HUGGINGFACE_API_KEY=

# VOID runtime
VOID_MODEL_TIMEOUT=180
VOID_CONTEXT_MAX_MESSAGES=24
VOID_CONTEXT_MAX_CHARS=60000
VOID_MODEL_RETRIES=2
VOID_API_MAX_BODY_BYTES=20971520
VOID_API_HOST=127.0.0.1
VOID_API_PORT=8787

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_WEBHOOK_PATH=/telegram
TELEGRAM_WEBHOOK_SECRET=

# Render deployment
ROUTER9_PORT=20128
ROUTER9_DATA_DIR=/tmp/9router
TELEGRAM_WEBHOOK_PORT=10001
TELEGRAM_WEBHOOK_PATH=/telegram
